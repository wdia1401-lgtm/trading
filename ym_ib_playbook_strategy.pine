//@version=6
// =============================================================================
//  YM INITIAL BALANCE PLAYBOOK  — strategy implementation (FIXED - TABLE DATA)
//  Source: edgeful "full IB playbook on YM" (5 rules, 128 NY sessions,
//          12/08/25 – 06/08/26). For educational purposes only.
//
//  Designed for:  YM (E-mini Dow) futures, 5-minute chart, NY session.
//  IB = first hour, 09:30–10:30 ET. Breakouts measured on a wick touch.
// =============================================================================

strategy("YM IB Playbook (FIXED)", "YM IB", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=25000, pyramiding=0, calc_on_every_tick=false,
     commission_type=strategy.commission.cash_per_order, commission_value=2.0,
     slippage=1)

// ================================ INPUTS ====================================
grpSess  = "Session / Initial Balance"
ibSess   = input.session("0930-1030", "IB window (first hour)", group=grpSess)
rthSess  = input.session("0930-1600", "Regular session", group=grpSess)
tz       = input.string("America/New_York", "Exchange timezone", group=grpSess)
noonHour = input.int(12, "Clock filter — no new breakouts at/after this hour (R3)", minval=0, maxval=23, group=grpSess)
pmHour   = input.int(14, "Afternoon scalp hour — flatten if no extension (R5)", minval=0, maxval=23, group=grpSess)

grpSetup     = "Setup filters"
entryMode    = input.string("Anticipation (Rule 1)", "Entry mode", options=["Anticipation (Rule 1)", "Breakout (Rule 2/3)"], group=grpSetup)
tradeLongs   = input.bool(true,  "Trade long trigger  1A (low formed first + top-quartile close)", group=grpSetup)
tradeShorts  = input.bool(true,  "Trade short trigger 1B (high formed first + bottom-quartile close)", group=grpSetup)
quartile     = input.float(0.25, "Close-in-range quartile (top/bottom)", minval=0.05, maxval=0.50, step=0.05, group=grpSetup)
skipRotation = input.bool(true,  "Skip rotation days (huge IB) — Rule 4C", group=grpSetup)

grpSize  = "IB size thresholds (% of price)"
smallPct = input.float(0.47, "Small IB below %  (Rule 4A)", step=0.01, group=grpSize)
largePct = input.float(0.70, "Large IB above %  (Rule 2A/2B)", step=0.01, group=grpSize)
hugePct  = input.float(0.90, "Huge / rotation IB above %  (Rule 4C)", step=0.01, group=grpSize)

grpMgmt         = "Trade management"
adaptiveTargets = input.bool(true, "Adaptive target: small IB -> 0.5x, else 1.0x (R4)", group=grpMgmt)
targetMult      = input.float(1.0, "Fixed target extension (x IB range) when not adaptive", step=0.1, group=grpMgmt)
ext05Mult       = input.float(0.5, "First extension level (x IB range)", step=0.1, group=grpMgmt)
holdRunners     = input.bool(true, "Hold runner days to the bell (Rule 2B/2C)", group=grpMgmt)
scalpNoExt      = input.bool(true, "Scalp out in PM if extension never prints (Rule 5)", group=grpMgmt)

grpViz     = "Visuals"
showLevels = input.bool(true, "Show IB & extension levels", group=grpViz)
showTable  = input.bool(true, "Show 10:30 checklist table", group=grpViz)

grpDebug     = "Diagnostics"
debugEveryIB = input.bool(false, "DEBUG: take a long on EVERY IB close (ignore all filters)", group=grpDebug)

// ======================== SESSION DETECTION ==================================
inIB   = not na(time(timeframe.period, ibSess,  tz))
inRTH  = not na(time(timeframe.period, rthSess, tz))
hourNY = hour(time, tz)
afterNoon = hourNY >= noonHour
afterPM   = hourNY >= pmHour

// ================================ STATE ======================================
var float ibHigh         = na
var float ibLow          = na
var float ibOpen         = na
var float ibRunningClose = na
var float ibClose        = na
var int   ibHighT        = na
var int   ibLowT         = na
var int   ibBars         = 0
var bool  ibClosed       = false
var bool  orderPlaced    = false
var bool  ext05Hit       = false
var bool  runnerActive   = false
var int   sideTaken      = 0
var float lvlStop        = na
var float lvlTarget      = na
var float lvlExt05       = na
var int   trigCount      = 0
var int   entryCount     = 0

// === SNAPSHOT VARIABLES: capture the IB state WHEN IT CLOSES for display ===
var float snapIbHigh      = na
var float snapIbLow       = na
var float snapIbRange     = na
var float snapIbRangePct  = na
var float snapClosePos    = na
var int   snapIbBars      = 0
var bool  snapLowFirst    = false
var bool  snapHighFirst   = false
var bool  snapTopClose    = false
var bool  snapBotClose    = false
var bool  snapIbGreen     = false
var bool  snapSmall       = false
var bool  snapLarge       = false
var bool  snapHuge        = false
var bool  snapLongTrig    = false
var bool  snapShortTrig   = false

// ==================== BUILD INITIAL BALANCE ================================
newDay = inIB and not inIB[1]
if newDay
    ibHigh         := high
    ibLow          := low
    ibOpen         := open
    ibHighT        := time
    ibLowT         := time
    ibBars         := 1
    ibRunningClose := close
    ibClose        := na
    ibClosed       := false
    orderPlaced    := false
    ext05Hit       := false
    runnerActive   := false
    sideTaken      := 0
    lvlStop        := na
    lvlTarget      := na
    lvlExt05       := na
else if inIB
    if high > ibHigh
        ibHigh  := high
        ibHighT := time
    if low < ibLow
        ibLow  := low
        ibLowT := time
    ibBars         += 1
    ibRunningClose := close

// Capture IB close on transition OUT of IB window
ibJustClosed = inIB[1] and not inIB
if ibJustClosed and not ibClosed
    ibClose  := ibRunningClose
    ibClosed := true
    
    // === SNAPSHOT THE STATE AT THIS EXACT MOMENT ===
    ibRange    = ibHigh - ibLow
    ibRangePct = ibRange / ibClose * 100.0
    closePos   = ibRange > 0 ? (ibClose - ibLow) / ibRange : na
    lowFirst   = ibLowT < ibHighT
    highFirst  = ibHighT < ibLowT
    topClose   = closePos >= (1.0 - quartile)
    botClose   = closePos <= quartile
    ibGreen    = ibClose > ibOpen
    small      = ibRangePct < smallPct
    large      = ibRangePct > largePct
    huge       = ibRangePct > hugePct
    longTrig   = lowFirst and topClose
    shortTrig  = highFirst and botClose
    
    // SAVE SNAPSHOT
    snapIbHigh     := ibHigh
    snapIbLow      := ibLow
    snapIbRange    := ibRange
    snapIbRangePct := ibRangePct
    snapClosePos   := closePos
    snapIbBars     := ibBars
    snapLowFirst   := lowFirst
    snapHighFirst  := highFirst
    snapTopClose   := topClose
    snapBotClose   := botClose
    snapIbGreen    := ibGreen
    snapSmall      := small
    snapLarge      := large
    snapHuge       := huge
    snapLongTrig   := longTrig
    snapShortTrig  := shortTrig
    
    // Count triggers
    if longTrig
        trigCount += 1
    if shortTrig
        trigCount += 1

// ========================= DERIVED CONDITIONS ================================
// (These are recalculated every bar but used for logic; snapshots are for display)
ibRange    = ibHigh - ibLow
ibRangePct = na(ibClose) ? na : ibRange / ibClose * 100.0
closePos   = ibRange > 0 and not na(ibClose) ? (ibClose - ibLow) / ibRange : na

lowFirst  = ibLowT < ibHighT
highFirst = ibHighT < ibLowT
topClose  = closePos >= (1.0 - quartile)
botClose  = closePos <= quartile
ibGreen   = not na(ibClose) and ibClose > ibOpen

small = not na(ibRangePct) and ibRangePct < smallPct
large = not na(ibRangePct) and ibRangePct > largePct
huge  = not na(ibRangePct) and ibRangePct > hugePct

longTrig  = ibClosed and lowFirst and topClose
shortTrig = ibClosed and highFirst and botClose

// ============================== ENTRIES ======================================
rotationBlock = skipRotation and huge
canLong       = longTrig and tradeLongs and not rotationBlock and not debugEveryIB
canShort      = shortTrig and tradeShorts and not rotationBlock and not debugEveryIB
anticipation  = entryMode == "Anticipation (Rule 1)"

// Target sizing (Rule 4)
tgtMult     = adaptiveTargets ? (small ? 0.5 : 1.0) : targetMult
longTarget  = ibHigh + tgtMult * ibRange
shortTarget = ibLow - tgtMult * ibRange
longExt05   = ibHigh + ext05Mult * ibRange
shortExt05  = ibLow - ext05Mult * ibRange

fireEntry = ibJustClosed and not orderPlaced

// LONG ENTRY
if fireEntry and canLong
    orderPlaced  := true
    sideTaken    := 1
    lvlStop      := ibLow
    lvlTarget    := longTarget
    lvlExt05     := longExt05
    runnerActive := ibGreen and large
    entryCount   += 1
    if anticipation
        strategy.entry("Long", strategy.long)
    else
        strategy.entry("Long", strategy.long, stop=ibHigh)

// SHORT ENTRY
if fireEntry and canShort
    orderPlaced  := true
    sideTaken    := -1
    lvlStop      := ibHigh
    lvlTarget    := shortTarget
    lvlExt05     := shortExt05
    runnerActive := (not ibGreen) and large
    entryCount   += 1
    if anticipation
        strategy.entry("Short", strategy.short)
    else
        strategy.entry("Short", strategy.short, stop=ibLow)

// DEBUG: force entry on every IB close
if debugEveryIB and fireEntry
    orderPlaced  := true
    sideTaken    := 1
    lvlStop      := ibLow
    lvlTarget    := longTarget
    lvlExt05     := longExt05
    runnerActive := false
    entryCount   += 1
    strategy.entry("Long", strategy.long)

// Rule 3: cancel unfilled breakout orders after noon
if not anticipation and afterNoon and strategy.position_size == 0 and orderPlaced
    strategy.cancel("Long")
    strategy.cancel("Short")

// ==================== TRACK EXTENSION HITS (RULE 5) ==========================
if strategy.position_size > 0 and high >= lvlExt05
    ext05Hit := true
if strategy.position_size < 0 and low <= lvlExt05
    ext05Hit := true

// ================================= EXITS =====================================
if strategy.position_size > 0
    longLimit = (runnerActive and holdRunners) ? na : lvlTarget
    strategy.exit("L-exit", from_entry="Long", stop=lvlStop, limit=longLimit)

if strategy.position_size < 0
    shortLimit = (runnerActive and holdRunners) ? na : lvlTarget
    strategy.exit("S-exit", from_entry="Short", stop=lvlStop, limit=shortLimit)

// Rule 5: scalp out in PM if extension never hit
pmScalp = scalpNoExt and afterPM and not ext05Hit and not (runnerActive and holdRunners)

// End of session: flatten everything
sessionEnding = inRTH[1] and not inRTH

if strategy.position_size != 0
    if sessionEnding
        strategy.close_all(comment="EOD flat")
    else if pmScalp
        strategy.close_all(comment="PM scalp (no ext)")

if sessionEnding
    strategy.cancel_all()

// ============================== VISUALS ======================================
showLine = showLevels and ibClosed and inRTH
plot(showLine ? ibHigh : na, "IB High", color.teal, 2, plot.style_linebr)
plot(showLine ? ibLow : na, "IB Low", color.red, 2, plot.style_linebr)
plot(showLine ? ibHigh + ext05Mult * ibRange : na, "+0.5x", color.new(color.teal, 55), 1, plot.style_linebr)
plot(showLine ? ibLow - ext05Mult * ibRange : na, "-0.5x", color.new(color.red, 55), 1, plot.style_linebr)
plot(showLine ? ibHigh + ibRange : na, "+1.0x", color.new(color.teal, 72), 1, plot.style_linebr)
plot(showLine ? ibLow - ibRange : na, "-1.0x", color.new(color.red, 72), 1, plot.style_linebr)
bgcolor(inIB ? color.new(color.blue, 92) : na, title="IB window")

// Trigger markers
plotshape(ibJustClosed and snapLongTrig, "Long trigger 1A", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(ibJustClosed and snapShortTrig, "Short trigger 1B", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// ========================= TIMEFRAME GUARD ==================================
tfTooCoarse = (not timeframe.isintraday) or (timeframe.in_seconds() > 900)
var label warnLbl = na
if barstate.islast
    label.delete(warnLbl)
    if tfTooCoarse or (ibClosed and ibBars <= 2)
        warnLbl := label.new(bar_index, high,
             "⚠ CRITICAL: Use 5-minute chart.\n" +
             "This playbook requires intraday ≤ 5-min.\n" +
             "Current TF is too coarse — 0 triggers possible.",
             style=label.style_label_down, color=color.orange,
             textcolor=color.black, size=size.normal)

// ========================= CHECKLIST TABLE ==================================
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 12, border_width=1, frame_width=1, frame_color=color.gray)
    
    // USE SNAPSHOT DATA (frozen from when IB closed)
    biasTxt  = snapLongTrig ? "LONG  (1A)" : snapShortTrig ? "SHORT (1B)" : "—"
    biasCol  = snapLongTrig ? color.new(color.green, 0) : snapShortTrig ? color.new(color.red, 0) : color.new(color.gray, 50)
    sizeTxt  = na(snapIbRangePct) ? "—" : snapHuge ? "HUGE" : snapLarge ? "LARGE" : snapSmall ? "SMALL" : "MID"
    firstTxt = snapIbBars == 0 ? "—" : snapLowFirst ? "LOW ↓" : snapHighFirst ? "HIGH ↑" : "tie"
    posTxt   = na(snapClosePos) ? "—" : snapTopClose ? "TOP" : snapBotClose ? "BOTTOM" : "MID"
    clockTxt = snapIbBars == 0 ? "pre-10:30" : afterNoon ? "AFTER NOON ⚠" : "early ✓"
    posState = strategy.position_size > 0 ? "LONG +" : strategy.position_size < 0 ? "SHORT -" : "FLAT"
    rangePctTxt = na(snapIbRangePct) ? "—" : str.tostring(snapIbRangePct, "#.##") + "%"
    candleTxt = snapIbBars == 0 ? "—" : snapIbGreen ? "GREEN" : "RED"

    table.cell(t, 0, 0, "YM IB — 10:30 Read", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=size.small)
    table.cell(t, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=size.small)
    table.cell(t, 0, 1, "IB bars", text_size=size.small)
    table.cell(t, 1, 1, str.tostring(snapIbBars), text_color=(snapIbBars <= 2 ? color.orange : color.gray), text_size=size.small)
    table.cell(t, 0, 2, "Range %", text_size=size.small)
    table.cell(t, 1, 2, rangePctTxt, text_size=size.small)
    table.cell(t, 0, 3, "Size", text_size=size.small)
    table.cell(t, 1, 3, sizeTxt, text_size=size.small)
    table.cell(t, 0, 4, "Formed first", text_size=size.small)
    table.cell(t, 1, 4, firstTxt, text_size=size.small)
    table.cell(t, 0, 5, "Close pos", text_size=size.small)
    table.cell(t, 1, 5, posTxt, text_size=size.small)
    table.cell(t, 0, 6, "IB color", text_size=size.small)
    table.cell(t, 1, 6, candleTxt, text_size=size.small)
    table.cell(t, 0, 7, "Clock", text_size=size.small)
    table.cell(t, 1, 7, clockTxt, text_size=size.small)
    table.cell(t, 0, 8, "Bias", text_size=size.small)
    table.cell(t, 1, 8, biasTxt, text_color=color.white, bgcolor=biasCol, text_size=size.small)
    table.cell(t, 0, 9, "Position", text_size=size.small)
    table.cell(t, 1, 9, posState, text_color=(strategy.position_size != 0 ? (strategy.position_size > 0 ? color.green : color.red) : color.gray), text_size=size.small)
    table.cell(t, 0, 10, "Triggers", text_size=size.small)
    table.cell(t, 1, 10, str.tostring(trigCount), text_color=(trigCount == 0 ? color.orange : color.gray), text_size=size.small)
    table.cell(t, 0, 11, "Entries", text_size=size.small)
    table.cell(t, 1, 11, str.tostring(entryCount), text_color=(entryCount == 0 ? color.orange : color.gray), text_size=size.small)

// ============================== ALERTS =======================================
alertcondition(ibJustClosed and snapLongTrig, "IB Long Trigger (1A)", "YM IB 1A fired: low formed first + top quartile close")
alertcondition(ibJustClosed and snapShortTrig, "IB Short Trigger (1B)", "YM IB 1B fired: high formed first + bottom quartile close")
